---
// 模範Block候補。列の位置ベース解釈: [0]=画像 [1]=タイトル [2]=リンク先。
import type { Cell } from '../../lib/markdown/parse-page';

export interface Props {
  name: string;
  variants: string[];
  rows: Cell[][];
}

const { rows, variants } = Astro.props;
---

<ul class="cards" data-variants={variants.join(' ')}>
  {rows.map((row) => {
    const [imageCell, titleCell, linkCell] = row;
    const image = imageCell?.images[0];
    const href = linkCell?.links[0]?.href ?? linkCell?.text;
    const body = (
      <>
        {image && <img class="cards__image" src={image.src} alt={image.alt} />}
        <p class="cards__title">{titleCell?.text}</p>
        {href && <span class="cards__cta">詳しく見る</span>}
      </>
    );
    return (
      <li class="cards__item">
        {href ? (
          <a class="cards__link" href={href}>
            {body}
          </a>
        ) : (
          body
        )}
      </li>
    );
  })}
</ul>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cards__item {
    border: 1px solid #ddd;
    border-radius: 4px;
    padding: 0.75rem;
    transition: box-shadow 0.15s ease;
  }
  .cards__item:has(.cards__link:hover) {
    box-shadow: 0 0 0 2px currentColor;
  }
  .cards__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }
  .cards__image {
    width: 100%;
    height: auto;
    display: block;
  }
  .cards__cta {
    /* タイトルの行数に関わらず、カードの下端に揃える(margin-top: autoでflexの余白を吸収)。 */
    align-self: flex-start;
    display: inline-block;
    margin-top: auto;
    padding: 0.375rem 0.75rem;
    border: 1px solid currentColor;
    border-radius: 4px;
    font-size: 0.875rem;
  }
</style>
