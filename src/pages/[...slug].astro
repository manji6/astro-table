---
// レンダリング層のエントリポイント。pagesコレクションのcatch-allルート。
// 多言語対応(オプトイン)時は、コンテンツのディレクトリ構成(pages/<locale>/*.md)が
// そのままURLのロケールプレフィックスになる。
import { getCollection } from 'astro:content';
import { parsePage } from '../lib/markdown/parse-page';
import { extractMetadata } from '../lib/markdown/extract-metadata';
import { extractSectionMetadata } from '../lib/markdown/extract-section-metadata';
import BlockRenderer from '../components/BlockRenderer.astro';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((entry) => {
    // "<locale>/index" は "<locale>"(= "/ja/"等)としてルーティングする。
    const slug = entry.id.replace(/\/index$/, '');
    return {
      params: { slug: slug || undefined },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { metadata, tree: treeAfterPageMetadata } = extractMetadata(parsePage(entry.body ?? ''));
const tree = extractSectionMetadata(treeAfterPageMetadata);

const [locale, ...rest] = entry.id.split('/');
const restPath = rest.join('/');
const path = restPath === 'index' ? '' : restPath;
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  pageType={entry.data.pageType}
  ogImage={entry.data.ogImage}
  noindex={entry.data.noindex}
  locale={locale}
  path={path}
  metadata={metadata}
>
  <BlockRenderer tree={tree} />
</Base>
