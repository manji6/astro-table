{
  "name": "astro-table",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Markdown(GFM表 = Block記法)をビルド時にAstroコンポーネントへ変換する軽量オーサリングシステム",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manji6/astro-table.git"
  },
  "keywords": [
    "astro",
    "cms",
    "markdown",
    "static-site-generator",
    "authoring"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "astro check",
    "e2e": "playwright test",
    "new:block": "node scripts/new-block.mjs",
    "new:product": "node scripts/new-product.mjs"
  },
  "dependencies": {
    "@adobe/adobe-client-data-layer": "^3.0.1",
    "astro": "^7.1.3",
    "hast-util-to-html": "^9.0.5",
    "mdast-util-to-hast": "^13.2.1",
    "mdast-util-to-string": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^20.11.0",
    "@playwright/test": "^1.61.1",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
